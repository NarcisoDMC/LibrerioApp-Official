# ── Configuración del backend de LibrerioApp ─────────────────────────────
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas `.env` al repositorio.

# Puerto del servidor local (dev)
PORT=3001

# Origen permitido por CORS (en producción: dominio del frontend en Vercel)
CORS_ORIGIN=http://localhost:3000

# Email de contacto para identificarnos ante OpenLibrary (requisito de su API,
# sube el rate limit de 1 a 3 peticiones/segundo)
OL_CONTACT_EMAIL=tu-email@dominio.com

# ── Obligatorias a partir de la Fase 4 (Base de datos + Auth) ─────────────
# Postgres serverless (Neon) con URL del pooler de conexiones
DATABASE_URL=postgresql://usuario:password@host/db

# Secretos JWT (mínimo 32 caracteres). Genera con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Obligatoria a partir de la Fase 7 (Bibliotecario IA) ──────────────────
# Clave de la API de DeepSeek (platform.deepseek.com)
DEEPSEEK_API_KEY=
{
    "name": "librerio-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/src/server.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate"
    },
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "dotenv": "^17.2.2",
        "drizzle-orm": "^0.44.5",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "postgres": "^3.4.7",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.19.32",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.39.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.48.0"
    }
}